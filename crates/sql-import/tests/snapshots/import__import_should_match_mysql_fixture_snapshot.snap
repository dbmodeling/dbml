---
source: crates/sql-import/tests/import.rs
expression: "import_sql_ddl(MYSQL, SqlDialect::Mysql).dbml"
---
Enum users_role {
  admin
  user
}

Table users {
  id int [pk, increment]
  email varchar(255) [not null, unique, note: 'Login e-mail']
  role users_role [not null, default: 'user']
  active boolean [not null, default: true]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (role, email) [name: 'idx_role']
  }
  Note: 'Users'
}

Table posts {
  id int [pk, increment]
  user_id int [not null]
}

Ref: posts.user_id > users.id [delete: set null, update: cascade]
