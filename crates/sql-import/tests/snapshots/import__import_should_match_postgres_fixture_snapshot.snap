---
source: crates/sql-import/tests/import.rs
expression: "import_sql_ddl(PG, SqlDialect::Postgres).dbml"
---
Enum order_status {
  pending
  paid
  "it's done"
}

Table users {
  id integer [pk]
  email varchar(255) [not null, note: 'Login e-mail']
  name text
  balance numeric(10,2) [not null, default: 0.00]
  active boolean [default: true]
  created_at timestamptz [not null, default: `now()`]
  tags text[]
  uid uuid [default: `gen_random_uuid()`]
  indexes {
    email [unique, name: 'users_email_key']
    (`lower(name)`, id) [name: 'idx_lower_name']
  }
  Note: 'Application users'
}

Table orders {
  id bigint [pk, increment]
  user_id integer [not null]
  status order_status [not null, default: 'pending']
  note varchar(50) [default: 'n/a']
}

Table items {
  id integer [pk, increment]
  order_id integer
  sku text
  qty integer [default: -1]
  indexes {
    (order_id, sku) [unique]
  }
}

Ref: orders.user_id > users.id [delete: cascade]

Ref: items.order_id > orders.id [update: restrict]
