{
  "name": "dbmodeling-vscode",
  "displayName": "DB Modeling",
  "description": "Visual and bidirectional relational database modeling with DBML in VS Code",
  "version": "0.4.0",
  "type": "module",
  "publisher": "dbmodeling",
  "license": "PolyForm-Noncommercial-1.0.0",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dbmodeling/dbml.git",
    "directory": "vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/dbmodeling/dbml/issues"
  },
  "homepage": "https://github.com/dbmodeling/dbml#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "browser": "./dist/extension.web.js",
  "activationEvents": [],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Em workspaces virtuais (vscode.dev, repositórios remotos) o canvas e a edição DBML funcionam; a conexão com banco (CLI dbml) não está disponível."
    },
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Em workspaces não confiáveis a conexão com o banco (execução da CLI dbml) fica desativada; o canvas e o editor DBML continuam disponíveis.",
      "restrictedConfigurations": [
        "dbmodeling.cliPath"
      ]
    }
  },
  "contributes": {
    "configuration": {
      "title": "DB Modeling",
      "properties": {
        "dbmodeling.defaultEditor": {
          "type": "string",
          "enum": [
            "text",
            "canvas"
          ],
          "enumDescriptions": [
            "Abre .dbml no editor de texto (diffs e conflitos do Source Control continuam em texto). Use o botão da barra de título para abrir o canvas.",
            "Abre .dbml no canvas visual por padrão (grava workbench.editorAssociations nas configurações do usuário)."
          ],
          "default": "text",
          "scope": "application",
          "description": "Editor padrão para arquivos .dbml."
        },
        "dbmodeling.cliPath": {
          "type": "string",
          "default": "dbml",
          "scope": "machine",
          "markdownDescription": "Caminho da CLI `dbml` usada por \"Conectar ao banco\" (importação somente leitura do esquema). Só vale nas configurações do usuário; um workspace não pode defini-lo. Um caminho diferente de `dbml` pede confirmação antes do primeiro uso."
        }
      }
    },
    "languages": [
      {
        "id": "dbml",
        "aliases": [
          "DBML",
          "dbml"
        ],
        "extensions": [
          ".dbml"
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbmodeling-sidebar",
          "title": "DB Modeling",
          "icon": "media/mark.svg"
        }
      ]
    },
    "views": {
      "dbmodeling-sidebar": [
        {
          "id": "dbmodeling.workspaceView",
          "name": "Esquemas DBML",
          "icon": "media/mark.svg",
          "contextualTitle": "DB Modeling"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dbmodeling.workspaceView",
        "contents": "Modele seu banco de dados visualmente, com a mesma bancada do app desktop.\n[Abrir DB Modeling](command:dbmodeling.openWorkbench)\n[Novo esquema DBML](command:dbmodeling.newFile)\nNenhum arquivo .dbml encontrado neste workspace."
      }
    ],
    "customEditors": [
      {
        "viewType": "dbmodeling.editor",
        "displayName": "Canvas DB Modeling",
        "selector": [
          {
            "filenamePattern": "*.dbml"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "dbmodeling.openWorkbench",
        "title": "Abrir DB Modeling",
        "icon": "$(database)",
        "category": "DB Modeling"
      },
      {
        "command": "dbmodeling.newFile",
        "title": "Novo esquema DBML",
        "icon": "$(add)",
        "category": "DB Modeling"
      },
      {
        "command": "dbmodeling.refresh",
        "title": "Atualizar lista",
        "icon": "$(refresh)",
        "category": "DB Modeling"
      },
      {
        "command": "dbmodeling.openCanvas",
        "title": "Abrir no canvas visual",
        "icon": "$(graph)",
        "category": "DB Modeling"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dbmodeling.openWorkbench",
          "when": "view == dbmodeling.workspaceView",
          "group": "navigation@1"
        },
        {
          "command": "dbmodeling.newFile",
          "when": "view == dbmodeling.workspaceView",
          "group": "navigation@2"
        },
        {
          "command": "dbmodeling.refresh",
          "when": "view == dbmodeling.workspaceView",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "dbmodeling.openCanvas",
          "when": "resourceExtname == .dbml",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "dbmodeling.openCanvas",
          "when": "resourceExtname == .dbml",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc -p ./ --noEmit",
    "package": "npx -y @vscode/vsce package --no-dependencies",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.145.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "5.1.1"
  }
}
